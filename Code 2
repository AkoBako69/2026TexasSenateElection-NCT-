// ---- Popular-vote display: rename EV text to PV and hide the game's EV column in results tables ----
try {
  if (!window.__pvRenameInstalled) {
    window.__pvRenameInstalled = true;
    var PV_RULES = [
      [/\bElectoral Votes\b/gi, "Popular Votes (PV)"],
      [/\bElectoral Vote\b/gi, "Popular Vote (PV)"],
      [/\bEVs\b/g, "PV"],
      [/\bEV\b/g, "PV"],
      [/\b270 to win\b/gi, "50% to win"]
    ];
    var pvFix = function (node) {
      if (!node) return;
      if (node.nodeType === 3) {
        var oldText = node.nodeValue, newText = oldText;
        for (var i = 0; i < PV_RULES.length; i++) {
          newText = newText.replace(PV_RULES[i][0], PV_RULES[i][1]);
        }
        if (newText !== oldText) node.nodeValue = newText;
      } else if (node.nodeType === 1) {
        var tag = node.tagName;
        if (tag === "SCRIPT" || tag === "STYLE" || tag === "TEXTAREA" || tag === "INPUT") return;
        var kids = node.childNodes;
        for (var j = 0; j < kids.length; j++) pvFix(kids[j]);
      }
    };
    // The game's per-county "PV" column is its electoral allocation, which is not proportional
    // (the county winner gets nearly all of it), so hide that column and keep the real vote counts.
    var pvHideColumn = function () {
      var tables = document.getElementsByTagName("table");
      for (var t = 0; t < tables.length; t++) {
        var rows = tables[t].rows;
        if (!rows || !rows.length) continue;
        var head = rows[0].cells, col = -1;
        for (var c = 0; c < head.length; c++) {
          var txt = (head[c].textContent || "").replace(/\s+/g, " ").trim();
          if (txt === "Popular Votes (PV)" || txt === "Popular Vote (PV)" || txt === "PV") col = c;
        }
        if (col < 0) continue;
        for (var r = 0; r < rows.length; r++) {
          var cell = rows[r].cells[col];
          if (cell) cell.style.display = "none";
        }
      }
    };
    var pvStart = function () {
      pvFix(document.body); pvHideColumn();
      new MutationObserver(function (mutations) {
        for (var m = 0; m < mutations.length; m++) {
          var mu = mutations[m];
          if (mu.type === "characterData") pvFix(mu.target);
          for (var a = 0; a < mu.addedNodes.length; a++) pvFix(mu.addedNodes[a]);
        }
        pvHideColumn();
      }).observe(document.body, { childList: true, subtree: true, characterData: true });
    };
    if (document.body) pvStart();
    else document.addEventListener("DOMContentLoaded", pvStart);
  }
} catch (e) { console.log("PV display skipped:", e); }
